DATABASE_URL=pglite:local
USE_PGLITE=1
# 1 = UI con datos demo ricos (default staging). 0 = solo DB real.
USE_FAKE_DATA=1

# Postgres Docker:
# USE_PGLITE=0
# USE_FAKE_DATA=0
# DATABASE_URL=postgresql://tival:tival@localhost:5432/tival

# URL pública de esta instancia. Calendly webhook = {APP_URL}/api/webhooks/calendly/…
# En Vercel: https://tu-dominio. En local con túnel: URL ngrok (no se pide en la UI).
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=America/Santiago
# Entorno de esta instancia (local | production | staging…).
# Prefijo NEXT_PUBLIC_ = disponible en client y server (estándar Next).
# Al registrar/actualizar el webhook Calendly solo se reemplaza ESTE valor.
NEXT_PUBLIC_TIVAL_ENV=local
# Workspace pack activo en esta instancia (ver src/workspaces/)
DEFAULT_WORKSPACE_SLUG=alfondo

# Inngest Cloud MCP / REST (prefijo sk-inn-api-…). No es el signing key de la app.
# Para Cursor: exportá INNGEST_API_KEY en el entorno del IDE (no basta solo .env.local).
INNGEST_API_KEY=
# Encolar jobs: default solo si NEXT_PUBLIC_TIVAL_ENV=production.
# Con DB compartida, dejá local en off. Override: INNGEST_ENABLED=1 + npm run inngest:dev
# INNGEST_ENABLED=0
# Slug del env en Inngest Cloud (prod en Vercel; local/CLI → "dev"):
INNGEST_ENV=dev
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Minutos tras inicio de reunión (Calendly) para empezar a buscar Notas/recording.
# Default 120 (~2h observadas en Gmail). En local podés bajarlo para probar.
# POST_MEET_LOOK_AFTER_MINUTES=120
# POST_MEET_MAX_POLLS=24
MERCADOPAGO_ACCESS_TOKEN=
TIVAL_INTERNAL_KEY=dev-internal-key

# Cifrado at-rest de secrets de integraciones (por workspace).
# Si falta, se deriva de TIVAL_INTERNAL_KEY (solo local).
INTEGRATIONS_ENCRYPTION_KEY=dev-integrations-encryption-key

# Google Drive OAuth (app Tival — tokens por workspace en DB).
# Redirect URI en Google Cloud:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/google-drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
